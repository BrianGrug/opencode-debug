{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@thecto/opencode-debug-plugin",
  "version": "1.6.3",
  "description": "Language-agnostic HTTP debugging and live logs for OpenCode v2 with ngrok tunneling support",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    }
  },
  "author": "The CTO",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrianGrug/opencode-debug.git"
  },
  "bugs": {
    "url": "https://github.com/BrianGrug/opencode-debug/issues"
  },
  "homepage": "https://github.com/BrianGrug/opencode-debug#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "debug",
    "debugging",
    "ngrok",
    "plugin"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun run scripts/build.ts && tsc --emitDeclarationOnly --declaration --outDir dist",
    "prepublishOnly": "bun run build"
  },
  "files": [
    "dist",
    "index.ts",
    "tui.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.28",
    "@ngrok/ngrok": "^1.4.1"
  },
  "devDependencies": {
    "@opentui/core": "^0.6.3",
    "@opentui/solid": "^0.6.3",
    "@types/bun": "latest",
    "@types/node": "latest",
    "solid-js": "1.9.12",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  }
}
